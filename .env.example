# ArchSync AI - Environment Configuration Example
# Copy this file to .env for local development
# IMPORTANT: Never commit actual secret keys or credentials to version control.

# Server Configuration
# PORT=5000
# NODE_ENV=development

# Client URL (for CORS and cookie origin authorization, comma-separated for multiple origins)
# CLIENT_URL=http://localhost:5173

# Reverse Proxy Configuration (set to true behind Render, Cloudflare, etc.)
# TRUST_PROXY=false

# Database Connection (MongoDB Atlas or local MongoDB)
# MONGODB_URI=mongodb://localhost:27017/archsync

# Authentication & Security
# NOTE: In production (NODE_ENV=production), JWT_SECRET MUST be explicitly set and >= 32 characters
# JWT_SECRET=your_development_jwt_secret_min_32_chars_long
# JWT_EXPIRES_IN=7d
# COOKIE_NAME=auth_token
# Cookie SameSite: 'lax' for local dev, 'none' for cross-site (Vercel <-> Render) deployments
# COOKIE_SAME_SITE=lax

# Server-Side AI Integration (keep strictly server-side, never expose to frontend)
#GEMINI_API_KEY=your_gemini_api_key_here
#GEMINI_MODEL=gemini-2.5-flash
# AI_API_KEY=your_api_key
# AI_MODEL=gemini-2.5-flash

# Frontend Client Environment Variables (for client/.env or Vercel Environment Variables)
# In production on Vercel, point these to your Render backend:
# VITE_API_URL=https://archsync-server.onrender.com
# VITE_SOCKET_URL=https://archsync-server.onrender.com


