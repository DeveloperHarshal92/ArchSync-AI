# ArchSync AI - Environment Configuration Example
# Copy this file to .env for local development
# IMPORTANT: Never commit actual secret keys or credentials to version control.

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS and cookie origin authorization)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb://localhost:27017/archsync

# Authentication & Security
JWT_SECRET=your_development_jwt_secret_min_32_chars_long
JWT_EXPIRES_IN=7d

# Server-Side AI Integration (keep strictly server-side)
AI_API_KEY=your_ai_provider_api_key_here
AI_MODEL=gemini-1.5-pro
